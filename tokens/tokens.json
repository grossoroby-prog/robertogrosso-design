{
  "$description": "Single source of truth for robertogrosso.design. Compiled to src/styles/tokens.css by scripts/build-tokens.mjs and checked against Figma by scripts/drift.mjs.",
  "color": {
    "neutral": {
      "0":    { "$type": "color", "$value": "#FFFFFF" },
      "50":   { "$type": "color", "$value": "#F4F5F6" },
      "100":  { "$type": "color", "$value": "#E6E8EB" },
      "150":  { "$type": "color", "$value": "#EDEFF1" },
      "200":  { "$type": "color", "$value": "#D5D8DC" },
      "300":  { "$type": "color", "$value": "#B4B9C0" },
      "400":  { "$type": "color", "$value": "#9BA1A9" },
      "500":  { "$type": "color", "$value": "#5B6068" },
      "600":  { "$type": "color", "$value": "#3A3F46" },
      "700":  { "$type": "color", "$value": "#2A2E33" },
      "800":  { "$type": "color", "$value": "#15181B" },
      "850":  { "$type": "color", "$value": "#111316" },
      "900":  { "$type": "color", "$value": "#0A0A0A" }
    },
    "signal": {
      "positive": { "$type": "color", "$value": "#1F7A4D" },
      "negative": { "$type": "color", "$value": "#B3261E" },
      "info":     { "$type": "color", "$value": "#1D4ED8" },
      "caution":  { "$type": "color", "$value": "#9A5B00" }
    },
    "bg": {
      "page":    { "$type": "color", "$value": "{color.neutral.50}" },
      "raised":  { "$type": "color", "$value": "{color.neutral.0}" },
      "sunken":  { "$type": "color", "$value": "{color.neutral.100}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.900}" }
    },
    "fg": {
      "default":       { "$type": "color", "$value": "{color.neutral.900}" },
      "body":          { "$type": "color", "$value": "{color.neutral.600}" },
      "muted":         { "$type": "color", "$value": "{color.neutral.500}" },
      "inverse":       { "$type": "color", "$value": "{color.neutral.50}" },
      "inverse-body":  { "$type": "color", "$value": "#C9CDD2" },
      "inverse-muted": { "$type": "color", "$value": "{color.neutral.400}" }
    },
    "border": {
      "subtle":  { "$type": "color", "$value": "{color.neutral.200}" },
      "default": { "$type": "color", "$value": "{color.neutral.300}" },
      "strong":  { "$type": "color", "$value": "{color.neutral.900}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.700}" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', ui-monospace, Menlo, monospace" }
    },
    "size": {
      "label":   { "$type": "dimension", "$value": "12px" },
      "small":   { "$type": "dimension", "$value": "15px" },
      "body":    { "$type": "dimension", "$value": "17px" },
      "lead":    { "$type": "dimension", "$value": "20px" },
      "h3":      { "$type": "dimension", "$value": "24px" },
      "h2":      { "$type": "dimension", "$value": "clamp(30px, 3.6vw, 48px)" },
      "display": { "$type": "dimension", "$value": "clamp(44px, 7vw, 96px)" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.045em" },
      "heading": { "$type": "dimension", "$value": "-0.03em" },
      "label":   { "$type": "dimension", "$value": "0.14em" }
    }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "24px" },
    "6":  { "$type": "dimension", "$value": "32px" },
    "7":  { "$type": "dimension", "$value": "48px" },
    "8":  { "$type": "dimension", "$value": "56px" },
    "9":  { "$type": "dimension", "$value": "96px" },
    "10": { "$type": "dimension", "$value": "112px" }
  },
  "size": {
    "container": { "$type": "dimension", "$value": "1200px" },
    "gutter":    { "$type": "dimension", "$value": "32px" },
    "control":   { "$type": "dimension", "$value": "52px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  }
}
